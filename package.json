{
  "name": "sprout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assetpack": "assetpack",
    "start": "pnpm dev",
    "build": "pnpm assetpack && pnpm format:check && pnpm lint && tsc && vite build",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:sync": "node scripts/sync-version.mjs",
    "ios:sync": "pnpm run version:sync && pnpm build && cap sync ios",
    "ios:open": "cap open ios",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@pixi/sound": "^6.0.1",
    "@pixi/ui": "^2.3.2",
    "capacitor-plugin-safe-area": "^5.0.1",
    "motion": "^13.1.0",
    "pixi.js": "^8.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@assetpack/core": "^1.7.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
