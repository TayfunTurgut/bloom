{
  "name": "bloom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assetpack": "assetpack",
    "start": "pnpm dev",
    "build": "pnpm assetpack && pnpm lint && tsc && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios:sync": "pnpm build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@pixi/ui": "^2.3.2",
    "pixi.js": "^8.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@assetpack/core": "^1.7.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
